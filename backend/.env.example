# Server Configuration
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/smartkitab
JWT_SECRET=smartkitab_jwt_secret_key_2026

# Frontend Application URL (used for verification links)
FRONTEND_URL=http://localhost:5173

# Gmail SMTP Email Configuration (for sending activation links)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-digit-gmail-app-password
EMAIL_FROM="SMARTKITAB" <your-email@gmail.com>

# Google OAuth (for Google Sign-In backend verification)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Cloudinary (Optional, for book image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
